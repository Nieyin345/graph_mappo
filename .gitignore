# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Test / tooling caches
.pytest_cache/
.pytest_tmp*/
.pytest-tmp*/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
htmlcov/

# Runtime outputs
outputs/
*.log
node-compile-cache/

# Model / data artifacts (checkpoints, trajectories, arrays)
*.pt
*.pkl
*.pkl.gz
*.npy
*.npz

# Env / secrets
.env
.env.*
!.env.example

# Temp dirs
tmp/
temp/
*.tmp

# Large generated data (H5 / weather / reference works)
dataset/*
!dataset/global/
dataset/global/*
!dataset/global/rate_stats.json
*.h5
weather/
ref_work/
# Local third-party source mirrors used only for comparison/profiling.
reference/

# Editors / OS
.vscode/
.idea/
.DS_Store
._*
Thumbs.db

.reasonix/
# Scratch scripts (see workspace red line: write scripts to .tmp/ then run)
.tmp/

# Agent/skill tooling (editor-side artifacts, not project source)
agent/
.agents/
skills-lock.json
# Downloaded Claude skill packs are workstation tooling. Existing tracked skill
# files remain tracked; new packs stay out of status/sync unless explicitly forced.
.claude/skills/*/

# Rescued server run records (kept locally on purpose, not versioned -- see
# server_results/README.md; it is experiment data, not source)
server_results/

# Trae IDE local project docs
.trae/
